# Go2 + Piper integration inventory (Task 1).
#
# Dock-specific values marked TODO-verify-on-dock / pending MUST be confirmed by
# running the probes recorded in
#   docs/hardware/go2-piper-integration-inventory.md
# on the Go2 expansion dock (Orin NX). This file holds NO real IPs, tokens, or
# serials -- use hostnames or placeholders.

# --- platform identity ---
UBROBOT_PLATFORM=go2_piper
UBROBOT_GRASP_PLATFORM=go2_piper

# --- dock environment (frozen; hard prerequisite) ---
# Host OS image pre-installed on the Orin NX dock (Noetic-era; NOT used at
# runtime -- all ROS 2 runs in Jazzy/Noble containers).
DOCK_HOST_OS=Ubuntu 20.04.5 LTS (kernel 5.10.104-tegra)
DOCK_JETPACK_VERSION=R35.3.1
DOCK_CUDA_VERSION=11.4
# Docker base for all ROS 2 Jazzy containers; must match the rest of the stack.
DOCKER_BASE_IMAGE=ros:jazzy-ros-base-noble
# Verified 2026-08-07: ros:jazzy-ros-base-noble pulls+runs on the dock
# (rclpy loads from /opt/ros/jazzy). Docker Hub is unreachable; mirror
# acceleration (daocloud etc.) is configured in /etc/docker/daemon.json.
DOCK_DOCKER_NOBLE_VERIFIED=yes
# Verified 2026-08-07: Intel RealSense D435IF detected (SN 336222070923,
# firmware 5.17.0.10, USB 3.2), /dev/video0..5 present.
DOCK_REALSENSE_KERNEL_OK=yes
# Verified 2026-08-07: can0 up at 1Mbps (gs_usb), ERROR-ACTIVE, candump
# received live Piper frames (0x2A1..0x2A5).
DOCK_CAN0_OK=yes

# --- Go2 ROS 2 interface (unitree DDS bridge, containerized on dock) ---
# Source/version identify which unitree_go2_sdk bridge is used; verified
# 2026-08-07: official unitree_go2_sdk installed to /usr/local
# (libunitree_go2_sdk.a, libunitree_ros2_idl_cpp.a). Go2 interface is Unitree
# private DDS over CycloneDDS (NOT ROS1) -> no ros1_bridge needed.
GO2_ROS2_BRIDGE_SOURCE=/unitree/lib/unitree_go2_sdk (official)
GO2_ROS2_BRIDGE_VERSION=unitree_go2_sdk (Go2, IDL rev present in /usr/local/include/unitree)
# ros2 => direct DDS interop with Jazzy containers; ros1 => ros1_bridge needed.
# Verified: Go2 interface is DDS/CycloneDDS, so 'ros2' path applies.
GO2_INTERFACE_TYPE=ros2
# Verified 2026-08-07: host .bashrc sets rmw_cyclonedds_cpp; Go2 DDS uses
# CycloneDDS on eth0. NOTE: running emos container uses rmw_zenoh_cpp -- see
# inventory Task 1 findings #3 (RMW unification needed in Task 3).
GO2_BRIDGE_RMW=rmw_cyclonedds_cpp
# /cmd_vel is fixed by design (cmd_vel_guard publishes it; bridge consumes it).
GO2_CMD_VEL_TOPIC=/cmd_vel
# Go2 DDS topics (unitree_go2_sdk): rt/sportmodecmd (cmd), rt/sportmodestate
# (state), rt/lowcmd, rt/lowstate. ROS 2 topic names to be exposed by the
# bridge are decided in Task 3.
GO2_ODOM_TOPIC=rt/sportmodestate (bridge output TBD in Task 3)
GO2_IMU_TOPIC=rt/imu (bridge output TBD in Task 3)
GO2_JOINT_STATES_TOPIC=rt/lf/lowstate (bridge output TBD in Task 3)
# Go2 body via eth0 192.168.123.18/24; body 192.168.123.161 reachable.
GO2_TF_ROOT_FRAME=base_link (confirm in Task 3)
# Go2 stand/stop via sport_client StandUp/StandDown/StopMove (SDK); whether
# bridge exposes them or a separate service -- TBD in Task 3.
GO2_STAND_PRIMITIVE=sport_client StandUp (TBD in Task 3)
GO2_STOP_PRIMITIVE=sport_client StopMove (TBD in Task 3)

# --- Piper (local on dock, can0) ---
PIPER_CAN_INTERFACE=can0
PIPER_DRIVER_START=ubrobot.robots.piper.piper_sdk_interface

# --- RGB-D perception input (camera on dock; streamed to remote service) ---
RGBD_COLOR_TOPIC=/camera/camera/color/image_raw
RGBD_DEPTH_TOPIC=/camera/camera/depth/image_rect_raw
RGBD_CAMERA_INFO_SOURCE=/camera/camera/color/camera_info

# --- remote perception service (x86 GPU server; NOT on the dock) ---
# Port 5802 from src/service/reasoning/http_reasoning_server.py.
REMOTE_PERCEPTION_SERVICE_URL=http://perception-server.local:5802
REMOTE_PERCEPTION_SERVICE_ENDPOINT=/grasp_poses
REMOTE_PERCEPTION_VERIFIED=pending

# --- ROS domain + calibration ---
ROS_DOMAIN_ID=0
CALIBRATION_VERSION=TODO-verify-on-dock
