<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ubrobot_manipulation</name>
  <version>0.1.0</version>
  <description>Controlled ROS 2 grasp capability for UBRobot (Piper workstation, Go2+Piper, future SO101).</description>
  <maintainer email="user@example.com">ubrobot</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ubrobot_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
