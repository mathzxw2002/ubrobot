# Go2 + Piper integration inventory (Task 1).
#
# Dock-specific values marked TODO-verify-on-dock / pending MUST be confirmed by
# running the probes recorded in
#   docs/hardware/go2-piper-integration-inventory.md
# on the Go2 expansion dock (Orin NX). This file holds NO real IPs, tokens, or
# serials -- use hostnames or placeholders.

# --- platform identity ---
UBROBOT_PLATFORM=go2_piper
UBROBOT_GRASP_PLATFORM=go2_piper

# --- dock environment (frozen; hard prerequisite) ---
# Host OS image pre-installed on the Orin NX dock (Noetic-era; NOT used at
# runtime -- all ROS 2 runs in Jazzy/Noble containers).
DOCK_HOST_OS=TODO-verify-on-dock
DOCK_JETPACK_VERSION=TODO-verify-on-dock
DOCK_CUDA_VERSION=TODO-verify-on-dock
# Docker base for all ROS 2 Jazzy containers; must match the rest of the stack.
DOCKER_BASE_IMAGE=ros:jazzy-ros-base-noble
# 'yes' only after the Noble docker probe succeeds on the dock (see inventory).
DOCK_DOCKER_NOBLE_VERIFIED=pending
DOCK_REALSENSE_KERNEL_OK=pending
DOCK_CAN0_OK=pending

# --- Go2 ROS 2 interface (unitree_ros2 bridge, containerized on dock) ---
# Source/version identify which unitree_ros2 bridge is used; ROS version of the
# bridge must interop with the Jazzy containers (same RMW + ROS_DOMAIN_ID).
GO2_ROS2_BRIDGE_SOURCE=TODO-verify-on-dock
GO2_ROS2_BRIDGE_VERSION=TODO-verify-on-dock
# ros2 => direct DDS interop with Jazzy containers; ros1 => ros1_bridge needed.
GO2_INTERFACE_TYPE=ros2
GO2_BRIDGE_RMW=TODO-verify-on-dock
# /cmd_vel is fixed by design (cmd_vel_guard publishes it; bridge consumes it).
GO2_CMD_VEL_TOPIC=/cmd_vel
GO2_ODOM_TOPIC=TODO-verify-on-dock
GO2_IMU_TOPIC=TODO-verify-on-dock
GO2_JOINT_STATES_TOPIC=TODO-verify-on-dock
GO2_TF_ROOT_FRAME=TODO-verify-on-dock
# How the Go2 is stood up / stopped (bridge built-in primitive vs separate svc).
GO2_STAND_PRIMITIVE=TODO-verify-on-dock
GO2_STOP_PRIMITIVE=TODO-verify-on-dock

# --- Piper (local on dock, can0) ---
PIPER_CAN_INTERFACE=can0
PIPER_DRIVER_START=ubrobot.robots.piper.piper_sdk_interface

# --- RGB-D perception input (camera on dock; streamed to remote service) ---
RGBD_COLOR_TOPIC=/camera/camera/color/image_raw
RGBD_DEPTH_TOPIC=/camera/camera/depth/image_rect_raw
RGBD_CAMERA_INFO_SOURCE=/camera/camera/color/camera_info

# --- remote perception service (x86 GPU server; NOT on the dock) ---
# Port 5802 from src/service/reasoning/http_reasoning_server.py.
REMOTE_PERCEPTION_SERVICE_URL=http://perception-server.local:5802
REMOTE_PERCEPTION_SERVICE_ENDPOINT=/grasp_poses
REMOTE_PERCEPTION_VERIFIED=pending

# --- ROS domain + calibration ---
ROS_DOMAIN_ID=0
CALIBRATION_VERSION=TODO-verify-on-dock
