# Robot Edge Environment Configuration
# Copy this file to .env and edit as needed

# Path to tokens JSON file (optional, or set directly in code)
UBROBOT_EDGE_TOKENS_FILE=./tokens.json

# Request max age (seconds) - reject older requests
UBROBOT_EDGE_REQUEST_MAX_AGE_SEC=300

# Nonce TTL (seconds) - how long to track used nonces
UBROBOT_EDGE_NONCE_TTL_SEC=600

# Execution mode (fixture/hardware)
UBROBOT_EDGE_MODE=fixture

# Hardware authority (false = no real hardware commands)
UBROBOT_EDGE_HARDWARE_AUTHORITY=false
