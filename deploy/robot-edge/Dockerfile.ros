# Robot Edge service container with ROS support (M6 read-only, M8 command).
# Based on the official ROS 2 Jazzy base image so rclpy is available for
# read-only graph introspection and Cortex action goals. No hardware SDKs
# are installed.
FROM ubrobot/emos:jazzy-m7-20260803 AS emos-source
FROM ros:jazzy-ros-base-noble

WORKDIR /app

# libgpiod2 + headers are required by the optional `gpiod` Python bindings
# used for the physical E-stop contact (M7). Ubuntu Noble ships libgpiod 2.x.
# python3-pip is absent from the ros:jazzy-ros-base image; Noble also enforces
# PEP 668, so runtime deps go into a dedicated virtualenv. The venv inherits
# system site-packages so rclpy and its system deps (PyYAML, rosidl, ...) are
# importable; pip-installed packages still take precedence inside the venv.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgpiod2 libgpiod-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv --system-site-packages /opt/edge-venv

# Runtime Python deps for the Edge service itself.
COPY requirements-robot-edge.txt .
COPY requirements-robot-edge-estop.txt .
RUN /opt/edge-venv/bin/pip install --no-cache-dir \
        -r requirements-robot-edge.txt \
        -r requirements-robot-edge-estop.txt

# Copy source code (contracts + edge service + ROS adapters).
COPY src/ubrobot_contracts /app/ubrobot_contracts/
COPY src/robot_edge /app/robot_edge/

# Cortex action type for the M8 command backend (VisionLanguageAction +
# its rosidl typesupport .so). Only this package is needed; the agent
# component framework is not. The venv inherits system site-packages, so
# /opt/ros/jazzy/... is visible to the service.
COPY --from=emos-source /opt/ros/jazzy/lib/python3.12/site-packages/automatika_embodied_agents \
    /opt/ros/jazzy/lib/python3.12/site-packages/automatika_embodied_agents
COPY --from=emos-source /opt/ros/jazzy/lib/python3.12/site-packages/automatika_embodied_agents-0.7.3-py3.12.egg-info \
    /opt/ros/jazzy/lib/python3.12/site-packages/automatika_embodied_agents-0.7.3-py3.12.egg-info
# All rosidl shared libraries for the cortex action package (the typesupport
# .so files link against the generator_c/typesupport_c family in /opt/ros/jazzy/lib).
COPY --from=emos-source /opt/ros/jazzy/lib/libautomatika_embodied_agents__rosidl_*.so \
    /opt/ros/jazzy/lib/
COPY --from=emos-source /opt/ros/jazzy/lib/libautomatika_ros_sugar__rosidl_*.so \
    /opt/ros/jazzy/lib/

# Health check uses stdlib urllib (no curl dependency). Ubuntu Noble has no
# bare `python` binary, so the healthcheck calls python3 explicitly.
HEALTHCHECK --interval=30s --timeout=5s \
    CMD python3 -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8780/v1/health/live', timeout=2).status==200 else 1)" || exit 1

EXPOSE 8780

CMD ["/opt/edge-venv/bin/python", "-m", "robot_edge.app"]
